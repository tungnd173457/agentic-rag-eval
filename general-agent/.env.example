# Copy thành .env rồi điền API key. eval/bootstrap.py sẽ ÉP các biến WEAVIATE_*
# về Weaviate local (localhost:8080) nên KHÔNG cần khai ở đây.

# ---- LLM (agent chat) ----
LLM_PROVIDER=openai                 # openai | ollama | openrouter
LLM_TIMEOUT=120
OPENAI_API_KEY=sk-...               # BẮT BUỘC nếu provider=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Embedding (index + query, PHẢI cùng model lúc ingest và lúc search) ----
EMBED_PROVIDER=openai               # openai | ollama
OPENAI_EMBED_MODEL=text-embedding-3-large

# ---- Ollama (nếu dùng provider=ollama cho LLM/embedding) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5vl:7b
OLLAMA_EMBED_MODEL=qwen3-embedding:4b

# ---- Retrieval / agent loop ----
MAX_TOOL_ROUNDS=8                   # số vòng tool trước khi buộc trả lời
KB_SEARCH_TOP_K=8                   # parent trả về sau rerank
KB_SEARCH_WIDE_K=50                 # child lấy trước rerank
KB_SEARCH_HYBRID_ALPHA=0.5          # 0=BM25, 1=vector, 0.5=hybrid

# ---- Rerank (tùy chọn; mặc định tắt) ----
USE_RERANKING=false
RERANK_PROVIDER=openrouter          # cohere | openrouter
COHERE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free

# ---- Chunking (parent/child theo ký tự) ----
PARENT_MODE=paragraph
PARENT_MAX_CHARS=1024
PARENT_SEPARATOR="\n\n"          # PHẢI có nháy kép → dotenv mới giải mã thành newline thật
CHILD_MAX_CHARS=512
CHILD_SEPARATOR="\n"             # nt
EMBED_BATCH_SIZE=32
EMBED_MAX_CHARS=2000

# ---- Mongo (KHÔNG cần cho eval; để trống) ----
MONGODB_URL=
